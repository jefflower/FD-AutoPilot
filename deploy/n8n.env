# ============================================================
# n8n 生产环境配置
# 与 fd-server 共享 PostgreSQL 数据库 fd_autopilot
# n8n 使用独立的 n8n schema
# ============================================================

# 数据库（与 fd-server 共享同一个 PostgreSQL，不同 schema）
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=fd_autopilot
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=fdadmin
DB_POSTGRESDB_PASSWORD=fdadmin123
DB_POSTGRESDB_SCHEMA=n8n

# 端口和访问
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=0.0.0.0
WEBHOOK_URL=http://localhost:5678/

# 执行数据保留
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

# 日志
N8N_LOG_LEVEL=info

# 允许 iframe 嵌入
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_SECURE_COOKIE=false

# 固定加密密钥（确保重启后 session 和 credentials 不失效）
# 生产环境请生成自己的密钥: openssl rand -base64 32
N8N_ENCRYPTION_KEY=duOIDPzQRIIOruGTJoZrPxunC8AMOv7K

# 禁用遥测
N8N_DIAGNOSTICS_ENABLED=false
