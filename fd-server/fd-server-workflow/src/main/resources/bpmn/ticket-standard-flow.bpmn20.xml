<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowable.org/fdserver"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">

  <process id="ticket-standard-flow" name="标准工单处理流程（并行翻译+回复）" isExecutable="true">

    <!-- ========== START ========== -->
    <startEvent id="start" name="工单进入">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('loopBackToAudit', false)}"/>
      </extensionElements>
    </startEvent>

    <sequenceFlow id="flow_start_to_fork" sourceRef="start" targetRef="parallel_fork_gw"/>

    <!-- ========== PARALLEL FORK ========== -->
    <parallelGateway id="parallel_fork_gw" name="并行拆分"/>

    <!-- ===== BRANCH 1: TRANSLATION ===== -->

    <!-- 翻译决策：检查是否已有完整翻译 -->
    <sequenceFlow id="flow_fork_to_decision_translate" sourceRef="parallel_fork_gw" targetRef="decision_translate"/>

    <serviceTask id="decision_translate" name="翻译跳过决策"
                 flowable:delegateExpression="${decisionDelegate}">
      <extensionElements>
        <flowable:field name="decisionType" stringValue="shouldSkipTranslation"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_decision_translate_to_skip_gw" sourceRef="decision_translate" targetRef="skip_translate_gw"/>

    <exclusiveGateway id="skip_translate_gw" name="是否跳过翻译"/>

    <!-- 跳过翻译：已有完整翻译 -->
    <sequenceFlow id="flow_skip_translate_yes" sourceRef="skip_translate_gw" targetRef="translation_skip_cb">
      <conditionExpression xsi:type="tFormalExpression">${skipAgent == true}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="translation_skip_cb" name="翻译跳过回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.translationSkip"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_translation_skip_to_merge" sourceRef="translation_skip_cb" targetRef="translate_branch_merge_gw"/>

    <!-- 不跳过翻译：执行 Agent -->
    <sequenceFlow id="flow_skip_translate_no" sourceRef="skip_translate_gw" targetRef="translate_agent">
      <conditionExpression xsi:type="tFormalExpression">${skipAgent == false}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="translate_agent" name="翻译 (Agent)"
                 flowable:delegateExpression="${agentTaskDelegate}">
      <extensionElements>
        <flowable:field name="agentCode" stringValue="gemini-translate"/>
        <flowable:field name="taskType" stringValue="ticket.translate"/>
        <flowable:field name="startCallback" stringValue="ticket.translationStarted"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_translate_to_env_gw" sourceRef="translate_agent" targetRef="translate_env_gw"/>

    <exclusiveGateway id="translate_env_gw" name="翻译执行环境检测"/>

    <sequenceFlow id="flow_translate_to_wait" sourceRef="translate_env_gw" targetRef="translate_agent_wait">
      <conditionExpression xsi:type="tFormalExpression">${pendingTaskType != null}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flow_translate_skip_wait" sourceRef="translate_env_gw" targetRef="translate_merge_gw">
      <conditionExpression xsi:type="tFormalExpression">${pendingTaskType == null}</conditionExpression>
    </sequenceFlow>

    <receiveTask id="translate_agent_wait" name="等待翻译完成"/>

    <sequenceFlow id="flow_translate_wait_to_merge" sourceRef="translate_agent_wait" targetRef="translate_merge_gw"/>

    <exclusiveGateway id="translate_merge_gw"/>

    <sequenceFlow id="flow_translate_merge_to_cb" sourceRef="translate_merge_gw" targetRef="translation_done_cb"/>

    <serviceTask id="translation_done_cb" name="翻译完成回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.translationDone"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_translate_cb_to_merge" sourceRef="translation_done_cb" targetRef="translate_branch_merge_gw"/>

    <!-- 翻译分支合并网关：合并 skip/done 两条路径，路由到 parallel_join 或 loopback -->
    <exclusiveGateway id="translate_branch_merge_gw" name="翻译分支合并" default="flow_translate_branch_to_join"/>

    <sequenceFlow id="flow_translate_branch_to_join" sourceRef="translate_branch_merge_gw" targetRef="parallel_join_gw"/>

    <sequenceFlow id="flow_translate_branch_loopback" sourceRef="translate_branch_merge_gw" targetRef="both_done_cb">
      <conditionExpression xsi:type="tFormalExpression">${loopBackToAudit == true}</conditionExpression>
    </sequenceFlow>

    <!-- ===== BRANCH 2: REPLY ===== -->

    <!-- 回复决策：检查最后对话是否来自客户 -->
    <sequenceFlow id="flow_fork_to_decision_reply" sourceRef="parallel_fork_gw" targetRef="decision_reply"/>

    <serviceTask id="decision_reply" name="回复跳过决策"
                 flowable:delegateExpression="${decisionDelegate}">
      <extensionElements>
        <flowable:field name="decisionType" stringValue="shouldSkipReply"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_decision_reply_to_skip_gw" sourceRef="decision_reply" targetRef="skip_reply_gw"/>

    <exclusiveGateway id="skip_reply_gw" name="是否跳过回复"/>

    <!-- 跳过回复：最后消息非客户 -->
    <sequenceFlow id="flow_skip_reply_yes" sourceRef="skip_reply_gw" targetRef="reply_skip_cb">
      <conditionExpression xsi:type="tFormalExpression">${skipAgent == true}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="reply_skip_cb" name="回复跳过回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.replySkip"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_reply_skip_to_merge" sourceRef="reply_skip_cb" targetRef="reply_branch_merge_gw"/>

    <!-- 不跳过回复：执行 Agent -->
    <sequenceFlow id="flow_skip_reply_no" sourceRef="skip_reply_gw" targetRef="reply_agent">
      <conditionExpression xsi:type="tFormalExpression">${skipAgent == false}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="reply_agent" name="回复 (Agent)"
                 flowable:delegateExpression="${agentTaskDelegate}">
      <extensionElements>
        <flowable:field name="agentCode" stringValue="notebooklm-reply"/>
        <flowable:field name="taskType" stringValue="ticket.reply"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_reply_to_env_gw" sourceRef="reply_agent" targetRef="reply_env_gw"/>

    <exclusiveGateway id="reply_env_gw" name="回复执行环境检测"/>

    <sequenceFlow id="flow_reply_to_wait" sourceRef="reply_env_gw" targetRef="reply_agent_wait">
      <conditionExpression xsi:type="tFormalExpression">${pendingTaskType != null}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flow_reply_skip_wait" sourceRef="reply_env_gw" targetRef="reply_merge_gw">
      <conditionExpression xsi:type="tFormalExpression">${pendingTaskType == null}</conditionExpression>
    </sequenceFlow>

    <receiveTask id="reply_agent_wait" name="等待回复完成"/>

    <sequenceFlow id="flow_reply_wait_to_merge" sourceRef="reply_agent_wait" targetRef="reply_merge_gw"/>

    <exclusiveGateway id="reply_merge_gw"/>

    <sequenceFlow id="flow_reply_merge_to_cb" sourceRef="reply_merge_gw" targetRef="reply_done_cb"/>

    <serviceTask id="reply_done_cb" name="回复完成回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.replyDone"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_reply_cb_to_merge" sourceRef="reply_done_cb" targetRef="reply_branch_merge_gw"/>

    <!-- 回复分支合并网关：合并 skip/done 两条路径，路由到 parallel_join 或 loopback -->
    <exclusiveGateway id="reply_branch_merge_gw" name="回复分支合并" default="flow_reply_branch_to_join"/>

    <sequenceFlow id="flow_reply_branch_to_join" sourceRef="reply_branch_merge_gw" targetRef="parallel_join_gw"/>

    <sequenceFlow id="flow_reply_branch_loopback" sourceRef="reply_branch_merge_gw" targetRef="both_done_cb">
      <conditionExpression xsi:type="tFormalExpression">${loopBackToAudit == true}</conditionExpression>
    </sequenceFlow>

    <!-- ========== PARALLEL JOIN ========== -->
    <parallelGateway id="parallel_join_gw" name="并行汇聚"/>

    <sequenceFlow id="flow_join_to_both_done" sourceRef="parallel_join_gw" targetRef="both_done_cb"/>

    <!-- ========== BOTH DONE CALLBACK ========== -->
    <serviceTask id="both_done_cb" name="翻译+回复完成回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.bothDone"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_both_done_to_notify" sourceRef="both_done_cb" targetRef="notify_audit">
      <extensionElements>
        <flowable:executionListener event="take" expression="${execution.setVariable('loopBackToAudit', false)}"/>
      </extensionElements>
    </sequenceFlow>

    <!-- ========== AUDIT NOTIFICATION ========== -->
    <serviceTask id="notify_audit" name="发送审核通知"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.notifyAudit"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_notify_to_audit" sourceRef="notify_audit" targetRef="audit_create"/>

    <!-- ========== AUDIT PHASE ========== -->
    <serviceTask id="audit_create" name="创建审核任务"
                 flowable:delegateExpression="${humanTaskDelegate}">
      <extensionElements>
        <flowable:field name="humanTaskType" stringValue="ticket.audit"/>
        <flowable:field name="startCallback" stringValue="ticket.auditStarted"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_audit_create_to_wait" sourceRef="audit_create" targetRef="audit_create_wait"/>

    <receiveTask id="audit_create_wait" name="等待审核完成"/>

    <sequenceFlow id="flow_audit_wait_to_result_gw" sourceRef="audit_create_wait" targetRef="audit_result_gw"/>

    <exclusiveGateway id="audit_result_gw" name="审核结果"/>

    <!-- PASS -->
    <sequenceFlow id="flow_audit_pass" sourceRef="audit_result_gw" targetRef="audit_pass_cb">
      <conditionExpression xsi:type="tFormalExpression">${auditResult == 'PASS'}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="audit_pass_cb" name="审核通过回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.auditPass"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_pass_to_end" sourceRef="audit_pass_cb" targetRef="end"/>

    <!-- REJECT → loop back to reply_agent（设置 loopBackToAudit 标记绕过并行汇聚） -->
    <sequenceFlow id="flow_audit_reject" sourceRef="audit_result_gw" targetRef="audit_reject_cb">
      <conditionExpression xsi:type="tFormalExpression">${auditResult == 'REJECT'}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="audit_reject_cb" name="审核驳回回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.auditReject"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_reject_to_reply" sourceRef="audit_reject_cb" targetRef="reply_agent">
      <extensionElements>
        <flowable:executionListener event="take" expression="${execution.setVariable('loopBackToAudit', true)}"/>
      </extensionElements>
    </sequenceFlow>

    <!-- RETRANSLATE → loop back to translate_agent（设置 loopBackToAudit 标记绕过并行汇聚） -->
    <sequenceFlow id="flow_audit_retranslate" sourceRef="audit_result_gw" targetRef="audit_retranslate_cb">
      <conditionExpression xsi:type="tFormalExpression">${auditResult == 'RETRANSLATE'}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="audit_retranslate_cb" name="审核驳回至翻译回调"
                 flowable:delegateExpression="${businessCallbackDelegate}">
      <extensionElements>
        <flowable:field name="callbackType" stringValue="ticket.auditRetranslate"/>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_retranslate_to_translate" sourceRef="audit_retranslate_cb" targetRef="translate_agent">
      <extensionElements>
        <flowable:executionListener event="take" expression="${execution.setVariable('loopBackToAudit', true)}"/>
      </extensionElements>
    </sequenceFlow>

    <!-- ========== END ========== -->
    <endEvent id="end" name="流程结束"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ticket_standard_flow">
    <bpmndi:BPMNPlane bpmnElement="ticket-standard-flow" id="BPMNPlane_ticket_standard_flow">

      <!-- ===== SHAPES ===== -->

      <!-- START -->
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <omgdc:Bounds x="60" y="302" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- PARALLEL FORK -->
      <bpmndi:BPMNShape id="shape_parallel_fork_gw" bpmnElement="parallel_fork_gw">
        <omgdc:Bounds x="140" y="300" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- BRANCH 1: TRANSLATION (上方 y=120) -->

      <!-- 翻译决策 -->
      <bpmndi:BPMNShape id="shape_decision_translate" bpmnElement="decision_translate">
        <omgdc:Bounds x="230" y="80" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_skip_translate_gw" bpmnElement="skip_translate_gw">
        <omgdc:Bounds x="370" y="90" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_translation_skip_cb" bpmnElement="translation_skip_cb">
        <omgdc:Bounds x="350" y="0" width="100" height="60"/>
      </bpmndi:BPMNShape>

      <!-- 翻译 Agent 及后续 -->
      <bpmndi:BPMNShape id="shape_translate_agent" bpmnElement="translate_agent">
        <omgdc:Bounds x="460" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_translate_env_gw" bpmnElement="translate_env_gw">
        <omgdc:Bounds x="640" y="100" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_translate_agent_wait" bpmnElement="translate_agent_wait">
        <omgdc:Bounds x="740" y="30" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_translate_merge_gw" bpmnElement="translate_merge_gw">
        <omgdc:Bounds x="920" y="100" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_translation_done_cb" bpmnElement="translation_done_cb">
        <omgdc:Bounds x="1020" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- 翻译分支合并网关 -->
      <bpmndi:BPMNShape id="shape_translate_branch_merge_gw" bpmnElement="translate_branch_merge_gw">
        <omgdc:Bounds x="1170" y="90" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- BRANCH 2: REPLY (下方 y=480) -->

      <!-- 回复决策 -->
      <bpmndi:BPMNShape id="shape_decision_reply" bpmnElement="decision_reply">
        <omgdc:Bounds x="230" y="450" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_skip_reply_gw" bpmnElement="skip_reply_gw">
        <omgdc:Bounds x="370" y="460" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reply_skip_cb" bpmnElement="reply_skip_cb">
        <omgdc:Bounds x="350" y="560" width="100" height="60"/>
      </bpmndi:BPMNShape>

      <!-- 回复 Agent 及后续 -->
      <bpmndi:BPMNShape id="shape_reply_agent" bpmnElement="reply_agent">
        <omgdc:Bounds x="460" y="440" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reply_env_gw" bpmnElement="reply_env_gw">
        <omgdc:Bounds x="640" y="460" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reply_agent_wait" bpmnElement="reply_agent_wait">
        <omgdc:Bounds x="740" y="540" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reply_merge_gw" bpmnElement="reply_merge_gw">
        <omgdc:Bounds x="920" y="460" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reply_done_cb" bpmnElement="reply_done_cb">
        <omgdc:Bounds x="1020" y="440" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- 回复分支合并网关 -->
      <bpmndi:BPMNShape id="shape_reply_branch_merge_gw" bpmnElement="reply_branch_merge_gw">
        <omgdc:Bounds x="1170" y="460" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- PARALLEL JOIN -->
      <bpmndi:BPMNShape id="shape_parallel_join_gw" bpmnElement="parallel_join_gw">
        <omgdc:Bounds x="1250" y="300" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- BOTH DONE CALLBACK -->
      <bpmndi:BPMNShape id="shape_both_done_cb" bpmnElement="both_done_cb">
        <omgdc:Bounds x="1350" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- AUDIT NOTIFICATION -->
      <bpmndi:BPMNShape id="shape_notify_audit" bpmnElement="notify_audit">
        <omgdc:Bounds x="1500" y="285" width="110" height="70"/>
      </bpmndi:BPMNShape>

      <!-- AUDIT PHASE -->
      <bpmndi:BPMNShape id="shape_audit_create" bpmnElement="audit_create">
        <omgdc:Bounds x="1650" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_audit_create_wait" bpmnElement="audit_create_wait">
        <omgdc:Bounds x="1810" y="290" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_audit_result_gw" bpmnElement="audit_result_gw">
        <omgdc:Bounds x="1990" y="300" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- PASS -->
      <bpmndi:BPMNShape id="shape_audit_pass_cb" bpmnElement="audit_pass_cb">
        <omgdc:Bounds x="2090" y="160" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- REJECT -->
      <bpmndi:BPMNShape id="shape_audit_reject_cb" bpmnElement="audit_reject_cb">
        <omgdc:Bounds x="2090" y="400" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- RETRANSLATE -->
      <bpmndi:BPMNShape id="shape_audit_retranslate_cb" bpmnElement="audit_retranslate_cb">
        <omgdc:Bounds x="2090" y="540" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- END -->
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <omgdc:Bounds x="2270" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- ===== EDGES (连线) ===== -->

      <!-- START → PARALLEL FORK -->
      <bpmndi:BPMNEdge id="edge_start_to_fork" bpmnElement="flow_start_to_fork">
        <omgdi:waypoint x="96" y="320"/>
        <omgdi:waypoint x="140" y="320"/>
      </bpmndi:BPMNEdge>

      <!-- FORK → 翻译决策 (向上) -->
      <bpmndi:BPMNEdge id="edge_fork_to_decision_translate" bpmnElement="flow_fork_to_decision_translate">
        <omgdi:waypoint x="160" y="300"/>
        <omgdi:waypoint x="160" y="110"/>
        <omgdi:waypoint x="230" y="110"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译决策 → 跳过网关 -->
      <bpmndi:BPMNEdge id="edge_decision_translate_to_skip_gw" bpmnElement="flow_decision_translate_to_skip_gw">
        <omgdi:waypoint x="330" y="110"/>
        <omgdi:waypoint x="370" y="110"/>
      </bpmndi:BPMNEdge>

      <!-- 跳过翻译 → 翻译跳过回调 -->
      <bpmndi:BPMNEdge id="edge_skip_translate_yes" bpmnElement="flow_skip_translate_yes">
        <omgdi:waypoint x="390" y="90"/>
        <omgdi:waypoint x="390" y="60"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译跳过回调 → 翻译分支合并 -->
      <bpmndi:BPMNEdge id="edge_translation_skip_to_merge" bpmnElement="flow_translation_skip_to_merge">
        <omgdi:waypoint x="450" y="30"/>
        <omgdi:waypoint x="1190" y="30"/>
        <omgdi:waypoint x="1190" y="90"/>
      </bpmndi:BPMNEdge>

      <!-- 不跳过翻译 → 翻译 Agent -->
      <bpmndi:BPMNEdge id="edge_skip_translate_no" bpmnElement="flow_skip_translate_no">
        <omgdi:waypoint x="410" y="110"/>
        <omgdi:waypoint x="460" y="120"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译 Agent → 环境网关 -->
      <bpmndi:BPMNEdge id="edge_translate_to_env_gw" bpmnElement="flow_translate_to_env_gw">
        <omgdi:waypoint x="580" y="120"/>
        <omgdi:waypoint x="640" y="120"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译环境网关 → 等待 (CLIENT_ONLY) -->
      <bpmndi:BPMNEdge id="edge_translate_to_wait" bpmnElement="flow_translate_to_wait">
        <omgdi:waypoint x="660" y="100"/>
        <omgdi:waypoint x="660" y="60"/>
        <omgdi:waypoint x="740" y="60"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译环境网关 → 合并 (SERVER_ONLY, 跳过等待) -->
      <bpmndi:BPMNEdge id="edge_translate_skip_wait" bpmnElement="flow_translate_skip_wait">
        <omgdi:waypoint x="680" y="120"/>
        <omgdi:waypoint x="920" y="120"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译等待 → 合并 -->
      <bpmndi:BPMNEdge id="edge_translate_wait_to_merge" bpmnElement="flow_translate_wait_to_merge">
        <omgdi:waypoint x="860" y="60"/>
        <omgdi:waypoint x="940" y="60"/>
        <omgdi:waypoint x="940" y="100"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译合并 → 翻译完成回调 -->
      <bpmndi:BPMNEdge id="edge_translate_merge_to_cb" bpmnElement="flow_translate_merge_to_cb">
        <omgdi:waypoint x="960" y="120"/>
        <omgdi:waypoint x="1020" y="120"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译完成回调 → 翻译分支合并 -->
      <bpmndi:BPMNEdge id="edge_translate_cb_to_merge" bpmnElement="flow_translate_cb_to_merge">
        <omgdi:waypoint x="1140" y="120"/>
        <omgdi:waypoint x="1170" y="110"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译分支合并 → PARALLEL JOIN (default) -->
      <bpmndi:BPMNEdge id="edge_translate_branch_to_join" bpmnElement="flow_translate_branch_to_join">
        <omgdi:waypoint x="1210" y="110"/>
        <omgdi:waypoint x="1270" y="110"/>
        <omgdi:waypoint x="1270" y="300"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译分支合并 → both_done_cb (loopback) -->
      <bpmndi:BPMNEdge id="edge_translate_branch_loopback" bpmnElement="flow_translate_branch_loopback">
        <omgdi:waypoint x="1190" y="130"/>
        <omgdi:waypoint x="1190" y="220"/>
        <omgdi:waypoint x="1410" y="220"/>
        <omgdi:waypoint x="1410" y="280"/>
      </bpmndi:BPMNEdge>

      <!-- FORK → 回复决策 (向下) -->
      <bpmndi:BPMNEdge id="edge_fork_to_decision_reply" bpmnElement="flow_fork_to_decision_reply">
        <omgdi:waypoint x="160" y="340"/>
        <omgdi:waypoint x="160" y="480"/>
        <omgdi:waypoint x="230" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 回复决策 → 跳过网关 -->
      <bpmndi:BPMNEdge id="edge_decision_reply_to_skip_gw" bpmnElement="flow_decision_reply_to_skip_gw">
        <omgdi:waypoint x="330" y="480"/>
        <omgdi:waypoint x="370" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 跳过回复 → 回复跳过回调 -->
      <bpmndi:BPMNEdge id="edge_skip_reply_yes" bpmnElement="flow_skip_reply_yes">
        <omgdi:waypoint x="390" y="500"/>
        <omgdi:waypoint x="390" y="560"/>
      </bpmndi:BPMNEdge>

      <!-- 回复跳过回调 → 回复分支合并 -->
      <bpmndi:BPMNEdge id="edge_reply_skip_to_merge" bpmnElement="flow_reply_skip_to_merge">
        <omgdi:waypoint x="450" y="590"/>
        <omgdi:waypoint x="1190" y="590"/>
        <omgdi:waypoint x="1190" y="500"/>
      </bpmndi:BPMNEdge>

      <!-- 不跳过回复 → 回复 Agent -->
      <bpmndi:BPMNEdge id="edge_skip_reply_no" bpmnElement="flow_skip_reply_no">
        <omgdi:waypoint x="410" y="480"/>
        <omgdi:waypoint x="460" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 回复 Agent → 环境网关 -->
      <bpmndi:BPMNEdge id="edge_reply_to_env_gw" bpmnElement="flow_reply_to_env_gw">
        <omgdi:waypoint x="580" y="480"/>
        <omgdi:waypoint x="640" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 回复环境网关 → 等待 (CLIENT_ONLY) -->
      <bpmndi:BPMNEdge id="edge_reply_to_wait" bpmnElement="flow_reply_to_wait">
        <omgdi:waypoint x="660" y="500"/>
        <omgdi:waypoint x="660" y="570"/>
        <omgdi:waypoint x="740" y="570"/>
      </bpmndi:BPMNEdge>

      <!-- 回复环境网关 → 合并 (SERVER_ONLY, 跳过等待) -->
      <bpmndi:BPMNEdge id="edge_reply_skip_wait" bpmnElement="flow_reply_skip_wait">
        <omgdi:waypoint x="680" y="480"/>
        <omgdi:waypoint x="920" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 回复等待 → 合并 -->
      <bpmndi:BPMNEdge id="edge_reply_wait_to_merge" bpmnElement="flow_reply_wait_to_merge">
        <omgdi:waypoint x="860" y="570"/>
        <omgdi:waypoint x="940" y="570"/>
        <omgdi:waypoint x="940" y="500"/>
      </bpmndi:BPMNEdge>

      <!-- 回复合并 → 回复完成回调 -->
      <bpmndi:BPMNEdge id="edge_reply_merge_to_cb" bpmnElement="flow_reply_merge_to_cb">
        <omgdi:waypoint x="960" y="480"/>
        <omgdi:waypoint x="1020" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 回复完成回调 → 回复分支合并 -->
      <bpmndi:BPMNEdge id="edge_reply_cb_to_merge" bpmnElement="flow_reply_cb_to_merge">
        <omgdi:waypoint x="1140" y="480"/>
        <omgdi:waypoint x="1170" y="480"/>
      </bpmndi:BPMNEdge>

      <!-- 回复分支合并 → PARALLEL JOIN (default) -->
      <bpmndi:BPMNEdge id="edge_reply_branch_to_join" bpmnElement="flow_reply_branch_to_join">
        <omgdi:waypoint x="1210" y="480"/>
        <omgdi:waypoint x="1270" y="480"/>
        <omgdi:waypoint x="1270" y="340"/>
      </bpmndi:BPMNEdge>

      <!-- 回复分支合并 → both_done_cb (loopback) -->
      <bpmndi:BPMNEdge id="edge_reply_branch_loopback" bpmnElement="flow_reply_branch_loopback">
        <omgdi:waypoint x="1190" y="460"/>
        <omgdi:waypoint x="1190" y="400"/>
        <omgdi:waypoint x="1410" y="400"/>
        <omgdi:waypoint x="1410" y="360"/>
      </bpmndi:BPMNEdge>

      <!-- JOIN → bothDone 回调 -->
      <bpmndi:BPMNEdge id="edge_join_to_both_done" bpmnElement="flow_join_to_both_done">
        <omgdi:waypoint x="1290" y="320"/>
        <omgdi:waypoint x="1350" y="320"/>
      </bpmndi:BPMNEdge>

      <!-- bothDone → 审核通知 -->
      <bpmndi:BPMNEdge id="edge_both_done_to_notify" bpmnElement="flow_both_done_to_notify">
        <omgdi:waypoint x="1470" y="320"/>
        <omgdi:waypoint x="1500" y="320"/>
      </bpmndi:BPMNEdge>

      <!-- 审核通知 → 创建审核 -->
      <bpmndi:BPMNEdge id="edge_notify_to_audit" bpmnElement="flow_notify_to_audit">
        <omgdi:waypoint x="1610" y="320"/>
        <omgdi:waypoint x="1650" y="320"/>
      </bpmndi:BPMNEdge>

      <!-- 创建审核 → 等待审核 -->
      <bpmndi:BPMNEdge id="edge_audit_create_to_wait" bpmnElement="flow_audit_create_to_wait">
        <omgdi:waypoint x="1770" y="320"/>
        <omgdi:waypoint x="1810" y="320"/>
      </bpmndi:BPMNEdge>

      <!-- 等待审核 → 审核结果网关 -->
      <bpmndi:BPMNEdge id="edge_audit_wait_to_result_gw" bpmnElement="flow_audit_wait_to_result_gw">
        <omgdi:waypoint x="1930" y="320"/>
        <omgdi:waypoint x="1990" y="320"/>
      </bpmndi:BPMNEdge>

      <!-- 审核通过 → 通过回调 -->
      <bpmndi:BPMNEdge id="edge_audit_pass" bpmnElement="flow_audit_pass">
        <omgdi:waypoint x="2010" y="300"/>
        <omgdi:waypoint x="2010" y="200"/>
        <omgdi:waypoint x="2090" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- 通过回调 → 结束 -->
      <bpmndi:BPMNEdge id="edge_pass_to_end" bpmnElement="flow_pass_to_end">
        <omgdi:waypoint x="2210" y="200"/>
        <omgdi:waypoint x="2270" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- 审核驳回 → 驳回回调 -->
      <bpmndi:BPMNEdge id="edge_audit_reject" bpmnElement="flow_audit_reject">
        <omgdi:waypoint x="2010" y="340"/>
        <omgdi:waypoint x="2010" y="440"/>
        <omgdi:waypoint x="2090" y="440"/>
      </bpmndi:BPMNEdge>

      <!-- 驳回回调 → 回到回复 Agent (循环) -->
      <bpmndi:BPMNEdge id="edge_reject_to_reply" bpmnElement="flow_reject_to_reply">
        <omgdi:waypoint x="2150" y="480"/>
        <omgdi:waypoint x="2150" y="680"/>
        <omgdi:waypoint x="520" y="680"/>
        <omgdi:waypoint x="520" y="520"/>
      </bpmndi:BPMNEdge>

      <!-- 审核驳回至翻译 → 翻译回调 -->
      <bpmndi:BPMNEdge id="edge_audit_retranslate" bpmnElement="flow_audit_retranslate">
        <omgdi:waypoint x="2010" y="340"/>
        <omgdi:waypoint x="2010" y="580"/>
        <omgdi:waypoint x="2090" y="580"/>
      </bpmndi:BPMNEdge>

      <!-- 翻译回调 → 回到翻译 Agent (循环) -->
      <bpmndi:BPMNEdge id="edge_retranslate_to_translate" bpmnElement="flow_retranslate_to_translate">
        <omgdi:waypoint x="2150" y="620"/>
        <omgdi:waypoint x="2150" y="720"/>
        <omgdi:waypoint x="520" y="720"/>
        <omgdi:waypoint x="520" y="160"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
