# ============================================================
# FD-AutoPilot 生产环境变量配置
# ============================================================
# 复制此文件为 .env 并填入实际值:
#   cp .env.production.example .env
#   vim .env
# ============================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# ---- 数据库 (PostgreSQL) ----
DB_URL=jdbc:postgresql://localhost:5432/fd_autopilot?currentSchema=fd_server
DB_USERNAME=fdadmin
DB_PASSWORD=fdadmin123

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ---- JWT 密钥 (生产环境必须更换！) ----
# 生成方式: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# ---- Freshdesk ----
FRESHDESK_DOMAIN=simsonn.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_WEBHOOK_SECRET=
FRESHDESK_SKIP_EMPLOYEE_IDS=158001343601,158000445778,158007774607

# ---- 超级密码 ----
SUPER_PASSWORD=your_super_password

# ---- n8n 工作流引擎 ----
N8N_ENABLED=true
N8N_EXTERNAL_URL=http://localhost:5678
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key

# ---- JVM 参数 ----
JAVA_OPTS=-Xmx1g -Xms512m -XX:+UseG1GC
