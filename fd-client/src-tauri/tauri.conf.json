{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fd-client",
  "version": "0.1.3",
  "identifier": "com.zangjiafu.fd-client",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../fd-web && npm run build",
    "frontendDist": "../../fd-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "fd-client",
        "width": 1400,
        "height": 900,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}