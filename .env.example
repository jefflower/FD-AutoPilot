# ============================================================
# FD-AutoPilot Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Database (H2)
DB_PASSWORD=<generate-strong-password>

# Redis
REDIS_PASSWORD=<generate-strong-password>

# JWT Secret (used for signing tokens, MUST be unique per deployment)
JWT_SECRET=<generate-uuid-or-random-string>

# Freshdesk Integration
FRESHDESK_DOMAIN=your-company.freshdesk.com
FRESHDESK_API_KEY=your-freshdesk-api-key
FRESHDESK_WEBHOOK_SECRET=<generate-strong-password>

# Super Password (for admin init and password reset)
SUPER_PASSWORD=<generate-strong-password>

# CORS (optional, comma-separated origins for production)
# Leave empty for development (allows localhost:*)
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com
