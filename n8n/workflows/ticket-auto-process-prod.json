{
  "name": "FD-AutoPilot 工单自动处理（生产版）",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "定时触发（每5分钟）",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fd-new-tickets",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook 触发（实时）",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "fd-new-tickets"
    },
    {
      "parameters": {
        "content": "## 工单自动处理工作流（生产版）\n\n### 流程\n1. 登录获取 JWT\n2. 获取待翻译工单（fdStatus=2 Open）\n3. 循环逐个处理每个工单：\n   - 刷新工单 Freshdesk 最新数据\n   - 调用翻译 Agent（含 AI 分类 + resolved 判断）→ 保存翻译结果\n   - 检查 resolved：\n     - resolved=true → 调用 resolve-completed 标记工单已解决\n     - resolved=false → 按分类路由\n   - 按分类路由：\n     - 产品故障 → 获取对话标注 → ticket-reply Agent → 检查回复是否为空\n       - 空 → ticket-reply-long Agent（RAG 模式）→ 保存回复 → 推送审核通知\n       - 非空 → 保存回复 → 推送审核通知\n     - 物流查询 / 商务合作 / 视频审查 / 其他 → 标记人工处理\n4. 循环结束 → 汇总结果\n\n### API 地址\n生产环境: http://47.110.152.25:9988",
        "height": 460,
        "width": 380
      },
      "id": "sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-460, -140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://47.110.152.25:9988/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"username\": \"n8n-service\",\n  \"password\": \"n8n-service\"\n}",
        "options": {}
      },
      "id": "login",
      "name": "登录获取 JWT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 150]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://47.110.152.25:9988/api/v1/n8n/tickets/pending?fdStatus=2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.data.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-pending",
      "name": "获取待处理工单",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [550, 150]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-tickets",
      "name": "展开工单数组",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [780, 150]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-tickets",
      "name": "逐个处理工单",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [1020, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $json.id }}/refresh",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "refresh-ticket",
      "name": "刷新工单 Freshdesk 数据",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://47.110.152.25:9988/api/v1/n8n/agents/ticket-translate/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: { ticketContent: $json.data.content, targetLang: 'zh-CN' }, refType: 'ticket', refId: String($json.data.id), timeoutMs: 300000 }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "call-translate",
      "name": "调用翻译 Agent（含分类）",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $('刷新工单 Freshdesk 数据').item.json.data.id }}/save-translation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { let raw = ($json.data && $json.data.output) || ''; const fm = raw.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/); if (fm) raw = fm[1]; raw = raw.trim(); let p = {}; try { p = JSON.parse(raw); } catch(e) {} const desc = p.description || ''; const convs = (p.conversations || []).map(c => ({ id: c.id, bodyText: c.bodyText || c.body_text || '' })); const category = p.category || 'OTHER'; const result = { translatedTitle: p.subject || '', translatedContent: JSON.stringify({ description: desc, conversations: convs }), targetLang: 'zh-CN', ticketCategory: category }; if (category === 'LOGISTICS_INQUIRY') { result.orderNumber = p.orderNumber || ''; result.trackingNumber = p.trackingNumber || ''; } if (category === 'VIDEO_REVIEW') { result.videoUrls = JSON.stringify(p.videoUrls || []); } return JSON.stringify(result); })() }}",
        "options": {}
      },
      "id": "save-translation",
      "name": "保存翻译结果（含分类）",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 150]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "field-category",
              "name": "category",
              "value": "={{ (() => { let raw = ($('调用翻译 Agent（含分类）').item.json.data && $('调用翻译 Agent（含分类）').item.json.data.output) || ''; const fm = raw.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/); if (fm) raw = fm[1]; raw = raw.trim(); try { return JSON.parse(raw).category || 'OTHER'; } catch(e) { return 'OTHER'; } })() }}",
              "type": "string"
            },
            {
              "id": "field-resolved",
              "name": "resolved",
              "value": "={{ (() => { let raw = ($('调用翻译 Agent（含分类）').item.json.data && $('调用翻译 Agent（含分类）').item.json.data.output) || ''; const fm = raw.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/); if (fm) raw = fm[1]; raw = raw.trim(); try { const p = JSON.parse(raw); return p.resolved === true ? 'RESOLVED' : 'NOT_RESOLVED'; } catch(e) { return 'NOT_RESOLVED'; } })() }}",
              "type": "string"
            },
            {
              "id": "field-ticketId",
              "name": "ticketId",
              "value": "={{ $('刷新工单 Freshdesk 数据').item.json.data.id }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "extract-category",
      "name": "提取分类",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2040, 150]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.resolved }}",
              "operation": "equal",
              "value2": "RESOLVED"
            }
          ]
        }
      },
      "id": "check-resolved",
      "name": "检查是否已解决",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2300, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $json.ticketId }}/resolve-completed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "resolve-completed",
      "name": "标记工单已解决",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2600, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.category }}",
              "operation": "equal",
              "value2": "PRODUCT_FAULT"
            }
          ]
        }
      },
      "id": "switch-category",
      "name": "分类路由",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2600, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $('刷新工单 Freshdesk 数据').item.json.data.id }}/annotations-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-annotations",
      "name": "获取对话标注",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2900, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://47.110.152.25:9988/api/v1/n8n/agents/ticket-reply/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: { ticketContent: $('刷新工单 Freshdesk 数据').item.json.data.content, lastAuditRemark: $('刷新工单 Freshdesk 数据').item.json.data.lastAuditRemark || '', annotations: $('获取对话标注').item.json.data.annotations || '' }, refType: 'ticket', refId: String($('刷新工单 Freshdesk 数据').item.json.data.id), timeoutMs: 300000 }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "call-product-reply",
      "name": "产品故障回复 Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3160, 150]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ ($json.data && $json.data.output) || '' }}",
              "operation": "equal",
              "value2": ""
            }
          ]
        }
      },
      "id": "check-reply-empty",
      "name": "检查回复是否为空",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [3420, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://47.110.152.25:9988/api/v1/n8n/agents/ticket-reply-long/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: { ticketContent: $('刷新工单 Freshdesk 数据').item.json.data.content, lastAuditRemark: $('刷新工单 Freshdesk 数据').item.json.data.lastAuditRemark || '', annotations: $('获取对话标注').item.json.data.annotations || '' }, refType: 'ticket', refId: String($('刷新工单 Freshdesk 数据').item.json.data.id), timeoutMs: 600000 }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "call-long-reply",
      "name": "长内容回复 Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3680, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $('刷新工单 Freshdesk 数据').item.json.data.id }}/mark-manual",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reason: 'AI 分类为' + ($json.category === 'LOGISTICS_INQUIRY' ? '物流查询' : $json.category === 'BUSINESS_COOPERATION' ? '商务合作' : $json.category === 'VIDEO_REVIEW' ? '视频审查' : '其他') + '，需人工处理' }) }}",
        "options": {}
      },
      "id": "mark-manual",
      "name": "标记人工处理",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2900, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $('刷新工单 Freshdesk 数据').item.json.data.id }}/save-reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { let raw = ($json.data && $json.data.output) || ''; const fm = raw.match(/```(?:\\w+)?\\s*([\\s\\S]*?)\\s*```/); if (fm) raw = fm[1]; raw = raw.trim(); let targetReply = raw; let zhReply = raw; try { const arr = JSON.parse(raw); if (Array.isArray(arr)) { targetReply = arr[0] || ''; zhReply = arr[1] || arr[0] || ''; } else if (typeof arr === 'string') { targetReply = arr; zhReply = arr; } } catch(e) {} return JSON.stringify({ targetReply, zhReply }); })() }}",
        "options": {}
      },
      "id": "save-reply",
      "name": "保存回复结果",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3940, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://47.110.152.25:9988/api/v1/n8n/tickets/{{ $('刷新工单 Freshdesk 数据').item.json.data.id }}/notify-audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('登录获取 JWT').item.json.data.accessToken }}"
            }
