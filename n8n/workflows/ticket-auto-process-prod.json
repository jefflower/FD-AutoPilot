        "assignments": {
          "assignments": [
            {
              "id": "field-processedCount",
              "name": "processedCount",
              "value": "={{ $items().length }}",
              "type": "number"
            },
            {
              "id": "field-summary",
              "name": "summary",
              "value": "=n8n 工单自动处理完成: 共处理 {{ $items().length }} 个工单",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "summary",
      "name": "汇总结果",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1020, 500]
    }
  ],
